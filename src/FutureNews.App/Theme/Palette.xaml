<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="BgColor">#0B0E14</Color>
    <Color x:Key="SurfaceColor">#131822</Color>
    <Color x:Key="SurfaceAltColor">#1A2130</Color>
    <Color x:Key="BorderColor">#232C3D</Color>
    <Color x:Key="TextColor">#E7ECF5</Color>
    <Color x:Key="TextDimColor">#8B95A9</Color>
    <Color x:Key="AccentColor">#4F8CFF</Color>
    <Color x:Key="AccentSoftColor">#1E3358</Color>
    <Color x:Key="SuccessColor">#3FD18B</Color>
    <Color x:Key="WarnColor">#F5C542</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>

    <!-- Brushes are declared with literal colours on purpose: routing them through
         <Color> resources makes WPF emit a deferred BAML reference that fails to
         deserialise when the brush is used from inside a ControlTemplate. -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#131822" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A2130" />
    <SolidColorBrush x:Key="BorderBrush" Color="#232C3D" />
    <SolidColorBrush x:Key="TextBrush" Color="#E7ECF5" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#8B95A9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3358" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FD18B" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F5C542" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CardSummary" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="MetaText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

</ResourceDictionary>
