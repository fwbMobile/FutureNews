<Window x:Class="FutureNews.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FutureNews.App.ViewModels"
        Title="FutureNews · 科技前沿每日简报"
        Height="820" Width="1180"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Header ═══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="FN" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="FutureNews" Style="{StaticResource BaseText}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="科幻科技领域 · 每日进展简报" Style="{StaticResource MetaText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="250" Height="32" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" Padding="10,6"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索标题 / 摘要 / 来源…" Style="{StaticResource MetaText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"
                                   Foreground="#6B7688" />
                    </Grid>
                    <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            Padding="16,7" Click="RefreshButton_Click" ToolTip="立即抓取一次最新进展">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RefreshIcon" Text="⟳" Foreground="White" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock x:Name="RefreshText" Text="立即更新" Foreground="White" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="14,7"
                            Click="SettingsButton_Click" Content="设置" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Body ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ───── Sidebar ───── -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="订阅领域" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />

                    <ItemsControl Grid.Row="1" x:Name="TopicList" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TopicItem}">
                                <Border Background="Transparent" CornerRadius="6" Padding="4,5" Margin="0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource TopicCheckBox}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,9,0" />
                                        <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding Brush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource BaseText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding CountLabel}" Style="{StaticResource MetaText}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="3">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="下次自动更新" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="NextRunText" Text="—" Style="{StaticResource BaseText}"
                                           FontSize="12.5" Margin="0,3,0,0" />
                                <TextBlock x:Name="SourceStatusText" Style="{StaticResource MetaText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───── Article list ───── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="18,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="FilterAll" GroupName="ViewFilter" Content="全部"
                                         Style="{StaticResource ChipToggle}" IsChecked="True"
                                         Checked="Filter_Checked" Tag="all" Margin="0,0,8,0" />
                            <RadioButton x:Name="FilterUnread" GroupName="ViewFilter" Content="未读"
                                         Style="{StaticResource ChipToggle}" Checked="Filter_Checked" Tag="unread" Margin="0,0,8,0" />
                            <RadioButton x:Name="FilterStarred" GroupName="ViewFilter" Content="收藏"
                                         Style="{StaticResource ChipToggle}" Checked="Filter_Checked" Tag="starred" Margin="0,0,8,0" />
                            <RadioButton x:Name="FilterToday" GroupName="ViewFilter" Content="今日简报"
                                         Style="{StaticResource ChipToggle}" Checked="Filter_Checked" Tag="today" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Style="{StaticResource IconButton}" Content="全部标为已读" Click="MarkAllRead_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox x:Name="ArticleList"
                             Background="Transparent" BorderThickness="0"
                             Padding="0" Margin="18,4,12,18"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ArticleItem}">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="15,13" Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- meta row -->
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding TopicText}" Foreground="{Binding TopicBrush}"
                                                                   FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource MetaText}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Venue}" Style="{StaticResource MetaText}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="220" Margin="0,0,8,0" />
                                                    <TextBlock Text="·" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="StarButton_Click"
                                                            ToolTip="收藏" Padding="6,3" Margin="0,0,4,0">
                                                        <TextBlock x:Name="StarGlyph" Text="☆" FontSize="14" Foreground="{StaticResource TextDimBrush}" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="OpenButton_Click"
                                                            ToolTip="打开原文" Padding="6,3" Content="↗" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- title -->
                                            <TextBlock Text="{Binding Title}" Margin="0,0,0,5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- one-liner -->
                                            <TextBlock Text="{Binding OneLiner}" Style="{StaticResource CardSummary}" Margin="0,0,0,8" />

                                            <!-- footer -->
                                            <Grid>
                                                <TextBlock Text="{Binding Url}" Style="{StaticResource MetaText}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="640" HorizontalAlignment="Left" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="CopyLink_Click"
                                                            Content="复制链接" Padding="8,3" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="ReadButton_Click"
                                                            Content="标记已读" Padding="8,3" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    <!-- empty state -->
                    <Border x:Name="EmptyState" Background="{StaticResource BgBrush}" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="◇" FontSize="40" Foreground="{StaticResource BorderBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="暂无内容" Style="{StaticResource BaseText}" FontSize="15"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock x:Name="EmptyHint" Style="{StaticResource MetaText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- busy overlay -->
                    <Border x:Name="BusyOverlay" Background="#CC0B0E14" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="220" Height="4" Foreground="{StaticResource AccentBrush}"
                                         Background="{StaticResource SurfaceAltBrush}" BorderThickness="0" />
                            <TextBlock x:Name="BusyText" Text="正在抓取最新进展…" Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════ Status bar ═══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,7">
                <TextBlock x:Name="StatusText" Style="{StaticResource MetaText}" VerticalAlignment="Center"
                           Text="准备就绪" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="打开数据目录" Click="OpenDataFolder_Click" Padding="8,3" Margin="0,0,6,0" />
                    <Button Style="{StaticResource IconButton}" Content="查看日志" Click="OpenLog_Click" Padding="8,3" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
