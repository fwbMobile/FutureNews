<Window x:Class="FutureNews.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FutureNews.App.ViewModels"
        Title="设置 — FutureNews"
        Height="660" Width="780"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource AppTabControl}">

            <!-- ═══════ 常规 ═══════ -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel>
                        <TextBlock Text="每日更新" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="更新时间" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="UpdateTimeBox" Style="{StaticResource AppTextBox}" Width="110" HorizontalAlignment="Left"
                                     ToolTip="格式 HH:mm，例如 08:30" />
                        </Grid>

                        <CheckBox x:Name="AutoUpdateCheck" Content="启用内置定时更新（托盘常驻）" Style="{StaticResource TopicCheckBox}" Margin="0,6,0,0" />
                        <CheckBox x:Name="RunOnStartupCheck" Content="开机自动启动" Style="{StaticResource TopicCheckBox}" Margin="0,6,0,0" />
                        <CheckBox x:Name="NotifyCheck" Content="更新完成后发送系统通知" Style="{StaticResource TopicCheckBox}" Margin="0,6,0,0" />
                        <CheckBox x:Name="NotifyOnlyMinimizedCheck" Content="仅在窗口最小化时通知" Style="{StaticResource TopicCheckBox}" Margin="0,6,0,16" />

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="抓取与筛选" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="回溯天数" Style="{StaticResource BaseText}" VerticalAlignment="Center"
                                       ToolTip="每次更新向前检索多少天的内容" />
                            <TextBox Grid.Column="1" x:Name="LookbackBox" Style="{StaticResource AppTextBox}" Width="110" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="每领域每日上限" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="MaxPerTopicBox" Style="{StaticResource AppTextBox}" Width="110" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全部领域每日上限" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="MaxPerDayBox" Style="{StaticResource AppTextBox}" Width="110" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相关度阈值" Style="{StaticResource BaseText}" VerticalAlignment="Center"
                                       ToolTip="数值越低越容易收到边缘内容，越高越精准" />
                            <TextBox Grid.Column="1" x:Name="MinScoreBox" Style="{StaticResource AppTextBox}" Width="110" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="历史保留天数" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="RetentionBox" Style="{StaticResource AppTextBox}" Width="110" HorizontalAlignment="Left" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="数据源" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <CheckBox x:Name="OpenAlexCheck" Content="启用 OpenAlex（覆盖 2.4 亿条文献；需填写下方 API Key，否则共用额度很快会限流）" Style="{StaticResource TopicCheckBox}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OpenAlex API Key" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <PasswordBox Grid.Column="1" x:Name="OpenAlexKeyBox" Style="{StaticResource AppPasswordBox}"
                                         PasswordChar="●" ToolTip="在 openalex.org/settings/api 免费申请。填写后使用独立额度" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="联系邮箱" Style="{StaticResource BaseText}" VerticalAlignment="Center"
                                       ToolTip="用于 Crossref / OpenAlex 的 polite pool，建议填写" />
                            <TextBox Grid.Column="1" x:Name="ContactEmailBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 摘要 ═══════ -->
            <TabItem Header="一句话摘要">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel>
                        <CheckBox x:Name="LlmCheck" Content="使用大模型生成摘要（关闭则使用本地抽取式摘要）" Style="{StaticResource TopicCheckBox}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="服务商" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ProviderCombo" Style="{StaticResource AppComboBox}"
                                      Width="340" HorizontalAlignment="Left"
                                      SelectionChanged="ProviderCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base URL" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="BaseUrlBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="ModelBox" Style="{StaticResource AppTextBox}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API Key" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                            <PasswordBox Grid.Column="1" x:Name="ApiKeyBox" Style="{StaticResource AppPasswordBox}" PasswordChar="●"
                                         ToolTip="使用 DPAPI 加密保存在本机，不会明文落盘" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="每批条数" Style="{StaticResource BaseText}" VerticalAlignment="Center"
                                       ToolTip="一次请求让模型总结多少条，批量越大越省 token" />
                            <TextBox Grid.Column="1" x:Name="BatchSizeBox" Style="{StaticResource AppTextBox}" Width="110" HorizontalAlignment="Left" />
                        </Grid>
                        <CheckBox x:Name="ChineseCheck" Content="输出中文摘要" Style="{StaticResource TopicCheckBox}" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="测试连接" Click="TestLlm_Click" Padding="16,7" />
                            <TextBlock x:Name="LlmTestResult" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource MetaText}" TextWrapping="Wrap"
                                       Text="未配置 API Key 时，工具会自动改用本地抽取式摘要：从论文摘要或新闻导语中抽取信息量最高的一句并压缩成一行，不会出现空白摘要。" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 领域 ═══════ -->
            <TabItem Header="领域参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="为每个领域单独调整相关度阈值、每日条数上限，或追加/排除关键词（用逗号分隔）。" />
                        <ItemsControl x:Name="TopicSettingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SubscriptionEdit}">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                <Ellipse Width="8" Height="8" Fill="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BaseText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="相关度阈值" Style="{StaticResource MetaText}" Margin="0,0,0,3" />
                                                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding MinScore, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1">
                                                    <TextBlock Text="每日上限" Style="{StaticResource MetaText}" Margin="0,0,0,3" />
                                                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding MaxPerDay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,8,0">
                                                    <TextBlock Text="追加关键词" Style="{StaticResource MetaText}" Margin="0,0,0,3" />
                                                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding ExtraKeywords, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                                    <TextBlock Text="排除关键词" Style="{StaticResource MetaText}" Margin="0,0,0,3" />
                                                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding ExcludeKeywords, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════ 系统 ═══════ -->
            <TabItem Header="系统">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel>
                        <TextBlock Text="计划任务" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="注册后，即使托盘程序没有运行，系统也会在设定时间自动抓取一次并弹出通知。可与托盘内置定时器同时使用，互不冲突。" />

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TaskStatusText" Text="状态：未知" Style="{StaticResource BaseText}" />
                                    <TextBlock Style="{StaticResource MetaText}" Margin="0,3,0,0" Text="任务名：FutureNews Daily Update" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="注册" Click="RegisterTask_Click" Padding="14,6" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="取消注册" Click="UnregisterTask_Click" Padding="14,6" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="数据与日志" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="打开数据目录" Click="OpenDataFolder_Click" Padding="14,6" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="查看日志" Click="OpenLog_Click" Padding="14,6" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="清空本地历史" Click="ClearHistory_Click" Padding="14,6" />
                        </StackPanel>

                        <TextBlock x:Name="DataPathText" Style="{StaticResource MetaText}" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource MetaText}" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════ Footer ═══════ -->
        <Border Grid.Row="1" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="SaveHint" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Click="Cancel_Click" Padding="18,7" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="保存" Click="Save_Click" Padding="22,7" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
